# ============================================
# Agentic RAG Nexus - Environment Variables
# ============================================

# --- App Settings ---
APP_NAME=Agentic RAG Nexus
DEBUG=false
ENVIRONMENT=development
HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501

# --- LLM Providers ---
# Groq (Recommended - Fast & Cheap)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (Optional fallback)
OPENAI_API_KEY=sk-your_openai_key_here

# Local (Ollama - Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Default LLM to use: groq | openai | ollama
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector DB (ChromaDB) ---
CHROMA_PERSIST_DIR=./vectorstore
CHROMA_COLLECTION_NAME=documents

# --- Database ---
DATABASE_URL=sqlite:///./agentic_rag.db

# --- Redis (Session Store) ---
REDIS_URL=redis://localhost:6379/0

# --- LangSmith Monitoring (Free) ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=agentic-rag-nexus

# --- Document Processing ---
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,docx,md
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Agent Settings ---
MAX_ITERATIONS=3
CRITIC_MIN_SCORE=7.0
HUMAN_APPROVAL_TIMEOUT=300